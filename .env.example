# Vault Environment Configuration

# --- Application ---
APP_NAME=Vault
APP_VERSION=0.1.0
DEBUG=true
DEMO_MODE=true
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
DATABASE_URL=postgresql+asyncpg://vault:vault_secret@localhost:5432/vault_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# --- Stripe (Test Mode) ---
STRIPE_SECRET_KEY=mk_1UAQENDTBkRSA1M6OJY8glE6
STRIPE_PUBLISHABLE_KEY=mk_1UAQEBDTBkRSA1M6s5Vz9Cqm
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_CONNECT_CLIENT_ID=ca_your_id_here

# --- Plaid (Sandbox) ---
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# --- Onfido ---
ONFIDO_API_TOKEN=your_onfido_token
ONFIDO_MOCK_MODE=true

# --- Notifications ---
SENDGRID_API_KEY=your_sendgrid_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- AWS ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=vault-assets

# --- AI Agent ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
